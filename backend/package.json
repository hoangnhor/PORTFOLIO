{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/services/portfolio.seed.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\"",
    "test": "node -e \"const cp=require('node:child_process');const run=(args)=>cp.spawnSync(process.execPath,args,{stdio:'inherit'});let r=run(['--test','--test-isolation=none','test/api.test.js']);if(r.status!==0){r=run(['--test','test/api.test.js']);}process.exit(r.status??1);\"",
    "test:smoke": "node --input-type=module -e \"import('./src/config/env.js').then(({validateEnv}) => { validateEnv(); console.log('smoke:ok'); }).catch((error) => { console.error(error); process.exit(1); })\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "eslint": "^9.38.0"
  }
}
