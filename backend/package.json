{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\"",
    "test": "node --test test/api.test.js test/rate-limit.fallback.test.js test/rate-limit.middleware.test.js test/portfolio.integration.test.js",
    "test:integration": "node --test test/portfolio.integration.test.js",
    "test:smoke": "node --input-type=module -e \"import('./src/config/env.js').then(({validateEnv}) => { validateEnv(); console.log('smoke:ok'); }).catch((error) => { console.error(error); process.exit(1); })\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.6.2"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
