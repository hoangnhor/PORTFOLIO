{
  "name": "hoang-portfolio-fullstack",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:be && npm run install:fe",
    "install:be": "npm --prefix backend install",
    "install:fe": "npm --prefix frontend install",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:be": "npm --prefix backend run dev",
    "dev:fe": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:fe": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
